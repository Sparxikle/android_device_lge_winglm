android_app {
    name: "WingParts",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    static_libs: [
        "androidx.core_core",
        "vendor.wing.hardware.motor-V1-java",
    ],
    optimize: {
        enabled: false,
    },
}
