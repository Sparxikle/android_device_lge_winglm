type immvibed, domain;
type immvibed_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(immvibed)

# Allow immvibed to use network sockets (as seen in stock sepolicy)
net_domain(immvibed)

# Allow hal_vibrator_default to connect to immvibed
allow hal_vibrator_default immvibed:unix_stream_socket connectto;

allow immvibed self:capability { setgid setuid sys_nice };

# Allow immvibed to set properties (stock sepolicy uses raw rules)
allow immvibed property_socket:sock_file write;
allow immvibed init:unix_stream_socket connectto;

allow immvibed persist_lg_data_file:dir search;
allow immvibed persist_lg_data_file:lnk_file read;

allow immvibed vendor_file:file { read open getattr };

allow immvibed tspdrv_device:chr_file rw_file_perms;
